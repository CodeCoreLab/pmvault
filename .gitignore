# ---------------------------------------------------------------------------
# pmvault — 密码管理器
#
# 根仓库的 .gitignore 已覆盖通用规则，本文件只补充本项目特有的规则。
# ---------------------------------------------------------------------------

# --- 运行期数据（保险箱：含加密后的密文库与备份，绝不入库） ----------------
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.vault
*.cvault

# --- 备份目录（备份是完整的密文库副本，含全部条目） ------------------------
backup/
backups/
emergency_backup_*.db
backup_*.db

# --- 日志 ---------------------------------------------------------------
logs/
*.log

# --- Go 构建产物 ---------------------------------------------------------
/src/phase-a/vaultd
/src/phase-a/vaultd.exe
/src/phase-edgeapp/vaultgui
/src/phase-edgeapp/vaultgui.exe
*.exe
*.syso.tmp

# --- 打包中间产物 -------------------------------------------------------
/src/phase-a/dist/
/src/phase-edgeapp/dist/
*.zip
*.7z

# --- Python 脚本缓存 ----------------------------------------------------
__pycache__/
*.pyc

# --- 编辑器 -------------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
